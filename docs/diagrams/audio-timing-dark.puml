@startuml audio-timing-dark
' Dark render. The body is audio-timing.iuml, shared with audio-timing.puml.
'
' Dark throughout, not a dark border around a white picture. These sit after
' !theme, which would otherwise reset them.
!theme plain

!$c_pkt   = "#243040"
!$c_frame = "#1E3D2B"

skinparam backgroundColor #0D1117
skinparam defaultFontColor #E6EDF3
skinparam titleFontColor #E6EDF3
skinparam headerFontColor #9198A1
skinparam captionFontColor #E6EDF3
skinparam ArrowColor #8B949E
skinparam ArrowFontColor #E6EDF3
skinparam timingBackgroundColor #161B22
skinparam timingBorderColor #30363D
skinparam timingFontColor #E6EDF3

' The waveform, the lane separators and the axis are drawn with one line colour
' that **no skinparam reaches**: there is no TimingLineColor, and ArrowColor does
' not apply. Left at the default the dark render draws black steps on a near
' black canvas, visible only where the highlight happens to sit behind them.
' The modern style API does reach it.
<style>
timingDiagram {
  LineColor #8B949E
}
</style>

!include audio-timing.iuml
@enduml
