@startuml scaling
' Light render. The body is scaling.iuml, shared with scaling-dark.puml,
' which supplies the same variables in dark values.
!theme plain

!$c_amber   = "#FFE082"
!$c_card    = "#FFFFFF"
!$c_green2  = "#C8E6C9"
!$c_hub     = "#FFF9C4"
!$c_indigo  = "#EDE7F6"
!$c_neutral = "#EEEEEE"
!$c_red     = "#FFCDD2"

!include scaling.iuml
@enduml
