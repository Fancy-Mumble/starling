@startuml deployment
' Light render. The body is deployment.iuml, shared with deployment-dark.puml,
' which supplies the same variables in dark values.
!theme plain

!$c_blue    = "#E3F2FD"
!$c_card    = "#FFFFFF"
!$c_core    = "#FFF8E1"
!$c_ess     = "#FFEBEE"
!$c_faint   = "#F5F5F5"
!$c_green   = "#E8F5E9"
!$c_green2  = "#C8E6C9"
!$c_gw      = "#FFE9D6"
!$c_gw2     = "#FFE0B2"
!$c_indigo  = "#EDE7F6"
!$c_neutral = "#EEEEEE"
!$c_red     = "#FFCDD2"

!$l_blue    = "#1565C0"
!$l_indigo  = "#4527A0"

!include deployment.iuml
@enduml
