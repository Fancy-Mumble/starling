@startuml services
' Light render. The body is services.iuml, shared with services-dark.puml,
' which supplies the same variables in dark values.
!theme plain

!$c_blue    = "#E3F2FD"
!$c_card    = "#FFFFFF"
!$c_core    = "#FFF8E1"
!$c_ess     = "#FFEBEE"
!$c_faint   = "#FAFAFA"
!$c_green   = "#E8F5E9"
!$c_gw      = "#FFE9D6"
!$c_gw2     = "#FFE0B2"
!$c_hub     = "#FFF9C4"
!$c_indigo  = "#EDE7F6"
!$c_neutral = "#EEEEEE"
!$c_purple  = "#F3E5F5"

!$l_amber   = "#F57C00"
!$l_blue    = "#1565C0"
!$l_green   = "#2E7D32"
!$l_indigo  = "#4527A0"
!$n_ink     = "black"
!$l_ink     = "#000000"
!$l_purple  = "#6A1B9A"
!$l_red     = "#C62828"

!include services.iuml
@enduml
