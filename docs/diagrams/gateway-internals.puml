@startuml gateway-internals
' Light render. The body is gateway-internals.iuml, shared with gateway-internals-dark.puml,
' which supplies the same variables in dark values.
!theme plain

!$c_blue    = "#E3F2FD"
!$c_card    = "#FFFFFF"
!$c_green   = "#E8F5E9"
!$c_gw      = "#FFE9D6"
!$c_gw2     = "#FFE0B2"
!$c_hub     = "#FFF9C4"
!$c_neutral = "#EEEEEE"

!$l_blue    = "#1565C0"

!include gateway-internals.iuml
@enduml
