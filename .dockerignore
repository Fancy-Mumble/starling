# The largest thing in the context, and pointless to send: the builder compiles
# into its own cache mount.
/target
/deploy/target

# Generated on first boot when no certificate is configured. A stale host cert
# must never be baked into an image.
/starling-data/
*.pem

# Nothing in the build reads git history, and the submodule's .git is a
# pointer into another tree anyway.
.git
.gitattributes
.gitignore

# Not inputs to `cargo build`.
#
# `starling.example.toml` is missing from this list on purpose: it stopped being
# documentation when `crates/starling/src/firstrun.rs` started `include_str!`ing
# it as the configuration a first start writes. Excluding it breaks the build.
/docs/
/.github/
/scripts/
/deploy/
/packaging/
Dockerfile
.dockerignore
docker-compose.yml
*.md

# Editor and OS cruft.
/.vscode/
/.idea/
*.swp
.DS_Store
Thumbs.db
