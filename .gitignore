/target
**/*.rs.bk

# cargo-fuzz's build tree (2.5 GB). The corpora and dictionaries beside it are
# committed on purpose - see docs/RELIABILITY.md Stage 1.
/fuzz/target/

# Where `cargo test --test soak` writes its samples and report.
/crates/starling/target/

# Auto-generated on first boot when no cert is configured.
/starling-data/
*.pem
# Except the throwaway key push's assertion test signs with. It is a fixture,
# not a credential, and without it that test only passes on the machine the
# file happens to exist on.
!crates/services/push/tests/service-account-key.pem

# Editor and OS cruft. Here because this repo has contributors now, not
# because any of it has ever been committed.
/.vscode/
/.idea/
*.swp
.DS_Store
Thumbs.db

# pnpm's content-addressable store. Same reasoning as the editor cruft above:
# this repo has no JavaScript at all, but a stray `pnpm` invocation leaves one
# in whatever directory it ran from, and it should never be staged.
.pnpm-store/

# Run logs from `starling --all-in-one` in this directory. Two of these were
# committed once; the server writes them wherever it is started from.
/starling-local*.log

# flatpak-builder scratch (packaging/flatpak/README.md)
.flatpak-builder/
